# ==============================================================================
# Cascading Logistics Delay Intelligence Platform - Environment Configuration
# ==============================================================================

# Core Application Execution Mode
NODE_ENV=development
PORT=3000
CLIENT_URL=http://localhost:5173

# High-Velocity Ingestion & Caching Layer (Redis Container Settings)
# Note: BullMQ worker pools require a high-throughput connection profile
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_STREAM_NAME=shipment:stream:events
REDIS_QUEUE_NAME=shipment-events

# Shard-Ready Persistent Storage Layer (MongoDB Atlas or Local Cluster)
# Targets the admin database container to authorize administrative credential tokens
MONGODB_URI=mongodb://admin:secure_logistics_password@localhost:27017/logistics?authSource=admin

# Cryptographic Token Authentication Keys (JWT Config)
# Generate heavy 64-character random hash parameters for production security variables
JWT_ACCESS_SECRET=your_hyper_secure_long_term_jwt_access_string_hash_here
JWT_REFRESH_SECRET=your_hyper_secure_long_term_jwt_refresh_string_hash_here
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# Hardcoded Bootstrap System Administrator (Initial Configuration Bypass Check)
SUPER_ADMIN_EMAIL=adminlogistics@gmail.com
SUPER_ADMIN_PASSWORD_HASH=zxcvbnm0987654321

# External Intelligence API Integrations (Third-Party Token Registries)
WEATHER_API_KEY=insert_your_weather_provider_secret_token_here
TRAFFIC_API_KEY=insert_your_traffic_and_routing_api_key_here
MAP_PROVIDER_API_KEY=insert_your_geocoding_and_tile_layer_key_here

# System Logging and Observability Matrix
# Options: fatal, error, warn, info, debug, trace
LOG_LEVEL=info